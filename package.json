{
  "name": "nara-notice-collector",
  "version": "0.3.0",
  "description": "A beginner-friendly tool for collecting, classifying, and exporting Korean public procurement notices.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "nara-notice-collector": "./dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "sample": "tsx src/cli.ts sample"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "nara",
    "procurement",
    "g2b",
    "csv",
    "excel"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "write-excel-file": "^4.0.7"
  }
}
